# CompliSense-AI marketing site — public env vars.
# Copy to .env.local for local dev, or set in the Vercel project for deploys.
# NEXT_PUBLIC_* values are exposed to the browser (they are public by design).

# Base URL of the CompliSense FastAPI backend that serves the DPDP Readiness API
# (/api/v1/readiness/*). Defaults to the production backend if unset.
NEXT_PUBLIC_API_BASE_URL=https://api.complisenseai.com

# Base URL of the hosted app (used for the "sign up to unlock full report" CTA).
NEXT_PUBLIC_APP_BASE_URL=https://complisense-ai-backend.onrender.com

# For local development against a backend running on localhost, use e.g.:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:10000
# NEXT_PUBLIC_APP_BASE_URL=http://localhost:10000
