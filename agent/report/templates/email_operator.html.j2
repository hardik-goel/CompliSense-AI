{#- Operator-facing readiness email: the client findings PLUS a sales-intel block at the
    top and the lead's raw answers. Sent only to OPERATOR_NOTIFY_EMAIL — never client-side.
    Email-safe inline styles; all values autoescaped. -#}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;margin:0;padding:24px 0;">
  <tr><td align="center">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#111827;">

      {#- Operator intel block -#}
      <tr><td style="padding:24px 32px 8px 32px;background:#0f172a;">
        <div style="font-size:12px;color:#93c5fd;letter-spacing:.08em;text-transform:uppercase;">Operator intel</div>
        <div style="font-size:18px;font-weight:700;color:#ffffff;margin-top:4px;">{{ email }}</div>
        <p style="font-size:13px;color:#cbd5e1;margin:6px 0 0;">
          Sector: <strong>{{ sector }}</strong> · Approx users: <strong>{{ user_count }}</strong> ·
          Submitted: {{ submitted_at }}
        </p>
        <p style="font-size:13px;color:#cbd5e1;margin:6px 0 0;">
          Gaps — Critical: <strong>{{ gap_counts.Critical }}</strong> ·
          Major: <strong style="color:#fca5a5;">{{ gap_counts.Major }}</strong> ·
          Minor: <strong>{{ gap_counts.Minor }}</strong>
        </p>
        <p style="font-size:14px;color:#fde68a;margin:10px 0 0;font-weight:600;">→ {{ suggested_angle }}</p>
      </td></tr>

      {#- Score header -#}
      <tr><td style="padding:20px 32px 0 32px;">
        <div style="font-size:13px;color:#6b7280;letter-spacing:.06em;text-transform:uppercase;">Readiness</div>
        <div style="font-size:36px;font-weight:800;color:#4f46e5;">{% if scoring_available %}{{ score }}%{% else %}Under assessment{% endif %}</div>
        <p style="font-size:13px;color:#374151;margin:6px 0 0;">Prepare-by deadline: {{ deadline }}.</p>
      </td></tr>

      {#- Findings (same as client) -#}
      {% if passes %}
      <tr><td style="padding:16px 32px 0 32px;">
        <div style="font-size:15px;font-weight:700;color:#065f46;">Already in place ({{ passes|length }})</div>
        <ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:#374151;">
          {% for p in passes %}<li>{{ p.title }}</li>{% endfor %}
        </ul>
      </td></tr>
      {% endif %}

      <tr><td style="padding:16px 32px 0 32px;">
        <div style="font-size:15px;font-weight:700;color:#92400e;">Gaps to close ({{ gaps|length }})</div>
        {% if gaps %}
        <ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:#374151;">
          {% for g in gaps %}<li style="margin-bottom:4px;"><strong>{{ g.title }}</strong> · {{ g.severity }}<br>
            <span style="color:#6b7280;word-break:break-word;">{{ g.citation }}</span></li>{% endfor %}
        </ul>
        {% else %}<p style="font-size:13px;color:#374151;">No gaps in answered areas.</p>{% endif %}
      </td></tr>

      {% if nas %}
      <tr><td style="padding:16px 32px 0 32px;">
        <div style="font-size:15px;font-weight:700;color:#374151;">Not applicable ({{ nas|length }})</div>
        <ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:#6b7280;">
          {% for n in nas %}<li>{{ n.title }} — {{ n.why }}</li>{% endfor %}
        </ul>
      </td></tr>
      {% endif %}

      {#- Raw answers (prep the call without logging in) -#}
      <tr><td style="padding:16px 32px 0 32px;">
        <div style="font-size:15px;font-weight:700;color:#111827;">Raw answers</div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px;font-size:12px;color:#374151;">
          {% for k, v in answers.items() %}
          <tr><td style="padding:2px 8px 2px 0;color:#6b7280;vertical-align:top;">{{ k }}</td><td style="padding:2px 0;">{{ v }}</td></tr>
          {% endfor %}
        </table>
      </td></tr>

      <tr><td style="padding:16px 32px 24px 32px;">
        <p style="font-size:11px;color:#9ca3af;line-height:1.6;margin:0;">
          Readiness assessment, not legal advice, not a determination of compliance.
          Rules current as of {{ rules_current_as_of }}. Internal — do not forward to the lead.
        </p>
      </td></tr>

    </table>
  </td></tr>
</table>
